# Base URL of the FastAPI API. In development leave the default "/api/v1":
# Vite proxies /api to the backend (see vite.config.js).
VITE_API_URL=/api/v1

# Only used by the dev server proxy
VITE_PROXY_TARGET=http://127.0.0.1:8000

# NEVER put AI provider keys or other secrets here: every VITE_* variable is
# bundled into public JavaScript. LLM keys live only in backend/.env.
