# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development

# PostgreSQL (required for production). Create the DB first:
#   createdb -U postgres finance_db
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/finance_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Must be true in production (HTTPS only)
COOKIE_SECURE=false

# Trusted frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One-click demo workspaces on the login page. Keep false in production.
DEMO_MODE=false
DEMO_TTL_HOURS=24

AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=10

# AI provider: "local" (rule-based, nothing leaves the server) or "anthropic"
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4000
